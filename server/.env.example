# Copy to server/.env and fill in your values

# MongoDB Atlas connection string (create a free cluster at cloud.mongodb.com)
MONGODB_URI=mongodb+srv://USER:PASSWORD@cluster0.xxxxx.mongodb.net/portfolio

# API port (default 5000)
PORT=5000

# SMTP email settings for the contact form
# For Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=587, and use an App Password
# (google.com -> Account -> Security -> App passwords; regular password will NOT work)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your.email@gmail.com
SMTP_PASS=your-16-char-app-password

# Where messages are delivered (defaults to SMTP_USER if empty)
CONTACT_TO=your.email@gmail.com